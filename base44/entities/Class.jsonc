{
  "name": "Class",
  "type": "object",
  "properties": {
    "semester_id": {
      "type": "string",
      "title": "Semester ID"
    },
    "name": {
      "type": "string",
      "title": "Class Name"
    },
    "instructor": {
      "type": "string",
      "title": "Instructor"
    },
    "room": {
      "type": "string",
      "title": "Room"
    },
    "color": {
      "type": "string",
      "default": "#3B82F6",
      "title": "Color"
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Days of Week"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "class_start_date": {
      "type": "string",
      "format": "date",
      "title": "Class Start Date"
    },
    "class_end_date": {
      "type": "string",
      "format": "date",
      "title": "Class End Date"
    }
  },
  "required": [
    "semester_id",
    "name"
  ]
}
{
  "name": "Class",
  "type": "object",
  "properties": {
    "semester_id": {
      "type": "string",
      "title": "Semester ID"
    },
    "name": {
      "type": "string",
      "title": "Class Name"
    },
    "instructor": {
      "type": "string",
      "title": "Instructor"
    },
    "room": {
      "type": "string",
      "title": "Room"
    },
    "color": {
      "type": "string",
      "default": "#3B82F6",
      "title": "Color"
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Days of Week"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "class_start_date": {
      "type": "string",
      "format": "date",
      "title": "Class Start Date"
    },
    "class_end_date": {
      "type": "string",
      "format": "date",
      "title": "Class End Date"
    },
    "recording_consent_confirmed": {
      "type": "boolean",
      "default": false,
      "title": "Recording Consent Confirmed",
      "description": "Whether the student has confirmed they have the instructor's permission to record this class."
    },
    "recording_consent_date": {
      "type": "string",
      "format": "date",
      "title": "Recording Consent Date",
      "description": "The date the student confirmed recording permission for this class (attestation timestamp)."
    },
    "user_id": {
      "type": "string",
      "title": "Owner User ID"
    }
  },
  "required": [
    "semester_id",
    "name",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
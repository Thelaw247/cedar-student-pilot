{
  "name": "ProcessedStripeEvent",
  "description": "Recoverability and audit ledger for Stripe-driven credit fulfillment. Atomic idempotency lives on CreditBalance.fulfilled_stripe_anchors; this entity records completed and failed attempts and can be repaired safely from that source.",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "anchor_id": {
      "type": "string",
      "title": "Anchor ID",
      "description": "The stable Stripe id used to dedupe: checkout session id for initial grants, invoice id for renewals, event id for tier sync / downgrade."
    },
    "kind": {
      "type": "string",
      "enum": [
        "subscription_initial",
        "pack",
        "subscription_renewal",
        "tier_sync",
        "downgrade",
        "monthly_grant"
      ],
      "title": "Kind"
    },
    "stripe_event_id": {
      "type": "string",
      "title": "Stripe Event ID"
    },
    "stripe_session_id": {
      "type": "string",
      "title": "Stripe Session ID"
    },
    "credits_granted": {
      "type": "number",
      "default": 0,
      "title": "Credits Granted"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "failed"
      ],
      "title": "Status"
    },
    "attempt_count": {
      "type": "number",
      "default": 0,
      "title": "Attempt Count"
    },
    "last_error": {
      "type": "string",
      "title": "Last Error"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Completed At"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Processed At"
    }
  },
  "required": [
    "user_id",
    "anchor_id",
    "kind"
  ],
  "rls": {
    "create": false,
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": false,
    "delete": false
  }
}
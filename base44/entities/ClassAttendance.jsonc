{
  "name": "ClassAttendance",
  "type": "object",
  "properties": {
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Session Date"
    },
    "attended": {
      "type": "boolean",
      "default": false,
      "title": "Attended"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Confirmed At"
    },
    "user_id": {
      "type": "string",
      "title": "Owner User ID"
    }
  },
  "required": [
    "class_id",
    "date",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
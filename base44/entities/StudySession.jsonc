{
  "name": "StudySession",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "title": "Assignment ID"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "title": "Scheduled Date"
    },
    "scheduled_time": {
      "type": "string",
      "title": "Scheduled Time"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (minutes)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "title": "Priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "skipped"
      ],
      "default": "scheduled",
      "title": "Status"
    },
    "title": {
      "type": "string",
      "title": "Session Title",
      "description": "Short name for this session, e.g. 'Biology Final \u2014 Session 3' or 'Final review'. Shown as the heading in the planner and calendar. Distinct from 'notes', which holds the longer description of what to do in the session."
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "description": "Longer description of what this session should cover. Shown under the title, not as the title."
    },
    "email_notified": {
      "type": "boolean",
      "default": false,
      "title": "Email Notified"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "study",
        "project"
      ],
      "default": "study",
      "title": "Session Type"
    },
    "roadmap_step_index": {
      "type": "number",
      "title": "Roadmap Step Index"
    }
  },
  "required": [
    "class_id",
    "scheduled_date"
  ]
}
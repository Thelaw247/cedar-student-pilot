{
  "name": "StudySession",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "title": "Assignment ID"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "title": "Scheduled Date"
    },
    "scheduled_time": {
      "type": "string",
      "title": "Scheduled Time"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (minutes)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "title": "Priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "skipped"
      ],
      "default": "scheduled",
      "title": "Status"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "email_notified": {
      "type": "boolean",
      "default": false,
      "title": "Email Notified"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "study",
        "project"
      ],
      "default": "study",
      "title": "Session Type"
    },
    "roadmap_step_index": {
      "type": "number",
      "title": "Roadmap Step Index"
    }
  },
  "required": [
    "class_id",
    "scheduled_date"
  ]
}
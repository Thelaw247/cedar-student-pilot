{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "type": {
      "type": "string",
      "enum": [
        "exam",
        "quiz",
        "project",
        "assignment"
      ],
      "default": "assignment",
      "title": "Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "archived"
      ],
      "default": "active",
      "title": "Status",
      "description": "Lifecycle of the assignment. 'active' is open/upcoming; 'completed' means the test/assignment is done; 'archived' hides a past item the student no longer needs. Resolving to completed/archived clears its leftover scheduled study sessions."
    },
    "coverage_scope": {
      "type": "string",
      "enum": [
        "cumulative",
        "since_last",
        "custom"
      ],
      "default": "cumulative",
      "title": "Coverage Scope"
    },
    "lecture_range_start": {
      "type": "string",
      "title": "Lecture Range Start"
    },
    "lecture_range_end": {
      "type": "string",
      "title": "Lecture Range End"
    },
    "description": {
      "type": "string",
      "title": "Project Description"
    },
    "project_metadata": {
      "type": "object",
      "additionalProperties": true,
      "title": "Project Metadata"
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "estimated_minutes": {
            "type": "number"
          }
        }
      },
      "title": "Project Roadmap"
    }
  },
  "required": [
    "class_id",
    "title",
    "due_date"
  ]
}
{
  "name": "CreditBalance",
  "description": "One row per user. The authoritative record of what a user is allowed to spend. Written ONLY by backend functions via asServiceRole - a user who can write this row has an infinite plan.",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "student",
        "scholar",
        "unlimited"
      ],
      "default": "free",
      "title": "Tier"
    },
    "subscription_credits": {
      "type": "number",
      "default": 0,
      "title": "Subscription Credits",
      "description": "Granted by the plan. Expire at period end. Spent BEFORE purchased credits."
    },
    "purchased_credits": {
      "type": "number",
      "default": 0,
      "title": "Purchased Credits",
      "description": "Bought in a pack. Never expire, survive cancellation."
    },
    "lifetime_granted": {
      "type": "number",
      "default": 0,
      "title": "Lifetime Granted",
      "description": "Total ever granted. Free tier uses this to enforce a lifetime cap rather than a monthly one."
    },
    "period_key": {
      "type": "string",
      "title": "Period Key",
      "description": "e.g. 2026-08. Used by the monthly grant job to avoid double-granting."
    },
    "last_grant_date": {
      "type": "string",
      "format": "date",
      "title": "Last Grant Date"
    },
    "fair_use_flagged": {
      "type": "boolean",
      "default": false,
      "title": "Fair Use Flagged"
    },
    "applied_credit_operations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Applied Credit Operations",
      "description": "Recent debit operation ids applied atomically to this balance. Prevents a retried settlement from charging twice."
    },
    "fulfilled_stripe_anchors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Fulfilled Stripe Anchors",
      "description": "Stripe session, invoice, and lifecycle anchors already reflected in this balance. This is the atomic idempotency source; ProcessedStripeEvent is the audit copy."
    },
    "stripe_customer_id": {
      "type": "string",
      "title": "Stripe Customer ID",
      "description": "The Stripe customer created on first checkout. Reused for the billing portal and subscription lifecycle. Set only by backend functions via asServiceRole."
    },
    "stripe_subscription_id": {
      "type": "string",
      "title": "Stripe Subscription ID",
      "description": "The active Stripe subscription id, synced from webhook events. Cleared on cancellation at period end. Set only by backend functions via asServiceRole."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": false,
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": false,
    "delete": false
  }
}
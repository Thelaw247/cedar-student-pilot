{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "lecture_id": {
      "type": "string",
      "title": "Lecture ID"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "front": {
      "type": "string",
      "title": "Front"
    },
    "back": {
      "type": "string",
      "title": "Back"
    },
    "ai_generated": {
      "type": "boolean",
      "default": true,
      "title": "AI Generated"
    },
    "user_id": {
      "type": "string",
      "title": "Owner User ID"
    }
  },
  "required": [
    "class_id",
    "front",
    "back",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
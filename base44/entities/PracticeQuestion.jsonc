{
  "name": "PracticeQuestion",
  "type": "object",
  "properties": {
    "lecture_id": {
      "type": "string",
      "title": "Lecture ID"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "question": {
      "type": "string",
      "title": "Question"
    },
    "answer": {
      "type": "string",
      "title": "Answer"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Options"
    },
    "type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "short_answer"
      ],
      "default": "multiple_choice",
      "title": "Type"
    },
    "ai_generated": {
      "type": "boolean",
      "default": true,
      "title": "AI Generated"
    },
    "user_id": {
      "type": "string",
      "title": "Owner User ID"
    }
  },
  "required": [
    "class_id",
    "question",
    "answer",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
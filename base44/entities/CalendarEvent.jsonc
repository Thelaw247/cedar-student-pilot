{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "type": {
      "type": "string",
      "enum": [
        "class",
        "custom",
        "study",
        "work",
        "appointment",
        "reminder"
      ],
      "default": "custom",
      "title": "Type"
    },
    "color": {
      "type": "string",
      "default": "#3B82F6",
      "title": "Color"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "reminder_minutes_before": {
      "type": "number",
      "title": "Reminder Minutes Before"
    },
    "class_id": {
      "type": "string",
      "title": "Linked Class ID"
    }
  },
  "required": [
    "title",
    "date"
  ]
}
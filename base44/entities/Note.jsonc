{
  "name": "Note",
  "type": "object",
  "properties": {
    "lecture_id": {
      "type": "string",
      "title": "Lecture ID"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Attachments"
    },
    "user_id": {
      "type": "string",
      "title": "Owner User ID"
    }
  },
  "required": [
    "class_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
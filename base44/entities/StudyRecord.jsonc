{
  "name": "StudyRecord",
  "type": "object",
  "properties": {
    "duration_seconds": {
      "type": "number",
      "title": "Duration (seconds)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "class_id": {
      "type": "string",
      "title": "Class ID"
    },
    "mode": {
      "type": "string",
      "enum": [
        "pomodoro",
        "simple"
      ],
      "title": "Mode"
    },
    "cycles_completed": {
      "type": "number",
      "title": "Cycles Completed"
    },
    "goal_minutes": {
      "type": "number",
      "title": "Goal Minutes"
    },
    "study_type": {
      "type": "string",
      "enum": [
        "in_app",
        "manual"
      ],
      "default": "manual",
      "title": "Study Type"
    },
    "study_mode": {
      "type": "string",
      "enum": [
        "deep",
        "sprint",
        "review"
      ],
      "title": "Study Mode"
    },
    "lectures_covered": {
      "type": "number",
      "default": 0,
      "title": "Lectures Covered"
    },
    "total_lectures": {
      "type": "number",
      "default": 0,
      "title": "Total Lectures Available"
    },
    "quiz_score": {
      "type": "number",
      "title": "Quiz Score (0-100)"
    },
    "quiz_questions_count": {
      "type": "number",
      "title": "Quiz Question Count"
    },
    "topics_reviewed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Topics Reviewed"
    },
    "user_id": {
      "type": "string",
      "title": "Owner User ID"
    }
  },
  "required": [
    "duration_seconds",
    "date",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
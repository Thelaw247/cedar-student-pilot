# Cloudflare Workers Static Assets applies these headers to every response.
# Keep connect-src aligned with the Supabase, API and R2 hosts the bundle calls.
#
# script-src and connect-src MUST also list https://in.heycatch.ai: the
# analytics SDK loads its own extensions from there and posts events to it
# (https://heycatch.ai/agents.md). Without it the browser blocks both and the
# dashboard stays empty with nothing failing on the server.
#
# connect-src MUST list the host in VITE_RENDER_API_URL (.env.cloudflare). When
# the build moved to api.praelecta.ca this file still only allowed the
# onrender.com host, so every API call from the new build was blocked by the
# browser and the live Worker had to be pinned to an older version — which then
# silently kept every later frontend deploy from reaching users (1 Sep audit).
# server/test/csp-api-host.test.js asserts the two files agree.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://in.heycatch.ai; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://media.base44.com https://i.ytimg.com https://*.r2.cloudflarestorage.com; connect-src 'self' https://in.heycatch.ai https://dyowooyijuxghwnwuxcr.supabase.co wss://dyowooyijuxghwnwuxcr.supabase.co https://api.praelecta.ca https://cedar-api-staging.onrender.com https://*.r2.cloudflarestorage.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' blob: https://*.r2.cloudflarestorage.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), microphone=(self), payment=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# The workers.dev hostname is staging, not a public search result. This
# absolute rule does not apply after the production custom domain is attached.
https://cedar-student-pilot.dewetluus.workers.dev/*
  X-Robots-Tag: noindex, nofollow

# Vite filenames contain content hashes, so these can be cached permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The hero's demo loop and its poster carry a version in the filename
# (hero-demo-v2.mp4), so a new cut is a new name and these can be cached
# as long as the bundle. Static assets here do NOT answer byte-range
# requests (a Range request gets the whole file and a 200), which Safari
# will not play a video from; LandingHero fetches the loop and plays it from
# a blob: URL for that reason, so media-src must keep blob:.
/hero-demo-*
  Cache-Control: public, max-age=31536000, immutable

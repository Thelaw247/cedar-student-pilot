# Live Base44 development remains the default when this flag is absent.
# Use these values only for the isolated Supabase/Render staging build.
VITE_BACKEND_MODE=supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_RENDER_API_URL=https://your-api.onrender.com
# Keep disabled until the matching provider is configured in Supabase Auth.
VITE_ENABLE_APPLE_AUTH=false
VITE_ENABLE_FACEBOOK_AUTH=false
